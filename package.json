{
  "name": "mai-hoonaa-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin-backend",
    "dev:admin-ui": "npm run dev --workspace=apps/admin-frontend",
    "build:packages": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "expo-local-authentication": "^57.0.2",
    "nodemailer": "^9.0.3",
    "react-native-modal-datetime-picker": "^18.0.0"
  }
}
